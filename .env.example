# Nexus frontend environment configuration
#
# Copy this file to `.env.local` for local development.
# Only values intentionally exposed to the browser may use the NEXT_PUBLIC_ prefix.
# Never place secrets, API keys, tokens, database credentials, or provider secrets here.

# Nexus Express/TypeScript API base URL used by the same-origin Next.js proxy.
# Keep this server-only; browser requests use /api/backend and never expose
# backend cookies or the upstream server address to client JavaScript.
NEXUS_API_URL=http://localhost:4000/api/v1

# Google sign-in has no frontend-specific setting. Authentication must use a
# documented backend OAuth flow through the existing same-origin API proxy.
# Do not add Google secrets or expose provider credentials in NEXT_PUBLIC_*.

# Socket.IO server URL. Required when real-time phases are implemented.
# Nexus Frontend — Environment Variables
#
# Copy this file to .env.local and fill in the values for your environment.
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real credentials.
# Only placeholder values belong in this file.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# Do NOT place secrets, API keys, database credentials, or private tokens
# in NEXT_PUBLIC_ variables.

# ---------------------------------------------------------------------------
# Backend REST API
# ---------------------------------------------------------------------------

# Base URL for the Nexus backend HTTP API.
# Include the path prefix if the backend mounts its API under a subpath (e.g. /api).
# Example (local development): http://localhost:5100/api
NEXT_PUBLIC_API_URL=http://localhost:5100/api

# ---------------------------------------------------------------------------
# Real-Time (Socket.IO)
# ---------------------------------------------------------------------------

# URL of the Nexus Socket.IO server.
# Required from Phase 9 onward. Safe to leave as placeholder until then.
# Example (local development): http://localhost:5100
NEXT_PUBLIC_SOCKET_URL=http://localhost:5100
