# Nexus frontend environment configuration
#
# Copy this file to `.env.local` for local development.
# Only values intentionally exposed to the browser may use the NEXT_PUBLIC_
# prefix. Never place secrets, API keys, tokens, database credentials, or
# provider secrets in this file.

# ---------------------------------------------------------------------------
# Backend REST API (server-only)
# ---------------------------------------------------------------------------
# Base URL of the Nexus Express/TypeScript API, including its version prefix.
# Browser requests go through the same-origin proxy at /api/backend, so this
# value is read only by the Next.js server and is never exposed to client
# JavaScript.
# Local example: http://localhost:4000/api/v1
NEXUS_API_URL=http://localhost:4000/api/v1

# ---------------------------------------------------------------------------
# Real-time (Socket.IO, browser-visible)
# ---------------------------------------------------------------------------
# URL of the Nexus Socket.IO server. WebSocket upgrades cannot pass through
# the serverless proxy, so the browser connects directly to this origin.
# Use the backend origin without a trailing slash.
# Local example: http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Backend origin for OAuth starts (browser-visible)
# ---------------------------------------------------------------------------
# Google sign-in and Google Calendar connection must start on the backend
# origin so the OAuth state cookie is set by the backend that will receive the
# callback. This is an origin only — never a secret.
# Local example: http://localhost:4000
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:4000

# ---------------------------------------------------------------------------
# Backend-only configuration (documented here for clarity)
# ---------------------------------------------------------------------------
# Google OAuth client credentials and callback URLs belong to the backend
# repository (__NexusBackend__). Do not add them to the frontend environment,
# and never expose GOOGLE_CLIENT_SECRET through a NEXT_PUBLIC_ variable.
